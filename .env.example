# Copy to .env and fill in. Everything is optional - the app runs fully without an API key.

# Optional: enables Claude to interpret free-form questions (numbers are always computed
# deterministically). Leave empty to use the built-in rule-based parser.
ANTHROPIC_API_KEY=

# Optional: Claude model used for question understanding.
LLM_MODEL=claude-opus-5-5

# Optional: set to 1 to force the rule-based parser even if a key is present.
DISABLE_LLM=0

# Optional: long-haul threshold in statute miles (default 2485 = 4,000 km, EUROCONTROL).
LONG_HAUL_THRESHOLD_MILES=2485
